{
  "name": "mise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/run.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/run.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/run.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:push:neon": "tsx -e \"import 'dotenv/config'; import { spawnSync } from 'node:child_process'; const r = spawnSync('npx', ['drizzle-kit', 'push', '--config', 'drizzle.neon.config.ts'], { stdio: 'inherit', shell: true, env: process.env }); process.exit(r.status ?? 1)\"",
    "db:studio": "drizzle-kit studio",
    "excel:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export_excel_data.ps1",
    "excel:import": "tsx scripts/import_excel.ts",
    "excel:sync": "npm run excel:export && npm run excel:import",
    "lint": "oxlint"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/localizations": "^4.13.10",
    "@hono/node-server": "^2.0.12",
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.34",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
