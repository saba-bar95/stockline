{
  "name": "mza-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "excel:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export_excel_data.ps1",
    "excel:import": "tsx scripts/import_excel.ts",
    "excel:sync": "npm run excel:export && npm run excel:import",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
