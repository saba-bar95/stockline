# Clerk (required for production auth)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Local SQLite is used when DATABASE_URL is unset.
# Production (Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Cap free kitchens; set REGISTRATION_OPEN=false to pause new orgs
MAX_ORGS=25
REGISTRATION_OPEN=true

# Comma-separated browser origins allowed by CORS
# Local: http://localhost:5173
# Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

PORT=3001

# After Railway deploy, put that host into vercel.json rewrites (see DEPLOY.md)
