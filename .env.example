# Clerk (required for production auth)
# Leave empty only for local offline work. Production / Neon MUST set CLERK_SECRET_KEY
# or the API refuses requests (it will not fall back to an open local org).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Local SQLite is used when DATABASE_URL is unset.
# Production (Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Cap free organizations; set REGISTRATION_OPEN=false to pause new orgs
MAX_ORGS=25
REGISTRATION_OPEN=true

# Comma-separated browser origins allowed by CORS (no trailing slash)
# Local: http://localhost:5173
# Prod: https://stockline-app-zt12.vercel.app
# Railway MUST include the live Vercel URL or browser calls fail CORS / JWT azp checks.
CORS_ORIGIN=http://localhost:5173

# Optional explicit JWT azp allowlist (defaults to HTTPS entries from CORS_ORIGIN)
# CLERK_AUTHORIZED_PARTIES=https://stockline-app-zt12.vercel.app

PORT=3001

# After Railway deploy, put that host into vercel.json rewrites (see DEPLOY.md)
